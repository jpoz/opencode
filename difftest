#!/usr/bin/env bash

# Build and run the diff test tool
set -e

cd "$(dirname "$0")"

# Build the tool
echo "Building difftest..."
go build -o difftest-bin ./cmd/difftest

# Check arguments and run appropriately
if [ $# -eq 0 ]; then
    if [ -t 0 ]; then
        echo "Running with sample diff in static mode (since no TTY available)..."
        ./difftest-bin --static
    else
        echo "Reading diff from stdin in static mode..."
        ./difftest-bin --static
    fi
else
    if [ "$1" = "--interactive" ]; then
        shift
        if [ $# -eq 0 ]; then
            echo "Running with sample diff..."
            ./difftest-bin
        else
            echo "Reading diff from file: $1"
            ./difftest-bin "$1"
        fi
    else
        echo "Reading diff from file: $1 (static mode)"
        ./difftest-bin --static "$1"
    fi
fi

# Cleanup
rm -f difftest-bin