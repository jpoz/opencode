@@ -0,0 +1,80 @@
+package cmd
+
+import (
+   "fmt"
+   "time"
+   "github.com/spf13/cobra"
+   "internal/metrics"
+)
+
+// statsCmd prints aggregated system metrics
+var statsCmd = &cobra.Command{
+   Use:   "stats",
+   Short: "Display usage metrics",
+   Long:  "Retrieve and display command execution and error metrics from internal storage.",
+   RunE: func(cmd *cobra.Command, args []string) error {
+       stats, err := metrics.LoadStats()
+       if err != nil {
+           return err
+       }
+       uptime := time.Since(stats.StartTime).Truncate(time.Second)
+       fmt.Printf("Commands: %d, Errors: %d, Uptime: %s\n", stats.Executed, stats.Errors, uptime)
+       return nil
+   },
+}
+
+// internal/metrics/metrics.go is assumed to provide the LoadStats method
