package cmd

import (
  "fmt"
  "time"
  "github.com/spf13/cobra"
  "github.com/sst/opencode/internal/metrics"
)

// statsCmd displays usage metrics
var statsCmd = &cobra.Command{
  Use:   "stats",
  Short: "Display usage and error metrics",
  Long:  "Retrieves and displays cumulative statistics such as total commands run, errors encountered, and tool uptime.",
  RunE: func(cmd *cobra.Command, args []string) error {
    stats, err := metrics.LoadStats()
    if err != nil {
      return fmt.Errorf("stats load error: %w", err)
    }
    elapsed := time.Since(stats.StartedAt).Truncate(time.Second)
    fmt.Printf("Commands executed: %d\nErrors: %d\nUptime: %s\n", stats.Total, stats.Errors, elapsed)
    return nil
  },
}

// metrics package defines a Stats struct and LoadStats() to retrieve metrics