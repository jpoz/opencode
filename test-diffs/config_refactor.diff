 // Load reads and merges config from file and environment
 func Load(path string) (Config, error) {
     fileCfg, err := loadFromFile(path)
     if err != nil {
         return Defaults, err
     }
     merged := mergeConfig(Defaults, fileCfg)
     if err := merged.Validate(); err != nil {
         return merged, err
     }
     return merged, nil
 }